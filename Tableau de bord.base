filters:
  and:
    - file.ext == "md"
    - or:
        - file.inFolder("PROJETS")
        - file.inFolder("COMPTA")
        - file.inFolder("RESSOURCE")
    - not:
        - file.inFolder("_templates")
formulas:
  note: file.asLink(file.basename)
  flux: if(type == "entree", "Entrée", if(type == "depense", "Dépense", type))
  tiers: if(type == "entree", source, payeur)
  montant_signe: if(montant, if(type == "entree", montant, -montant), "")
properties:
  formula.note:
    displayName: Note
  formula.flux:
    displayName: Opération
  formula.tiers:
    displayName: Tiers
  formula.montant_signe:
    displayName: Solde
  type:
    displayName: Type
  categorie:
    displayName: Catégorie
  statut:
    displayName: Statut
  responsable:
    displayName: Responsable
  participants:
    displayName: Participants
  priorite:
    displayName: Priorité
  echeance:
    displayName: Échéance
  date:
    displayName: Date
  projet:
    displayName: Projet
  montant:
    displayName: Montant
  payeur:
    displayName: Payeur
  source:
    displayName: Source
  recu_par:
    displayName: Reçu par
  moyen:
    displayName: Moyen
  affectation:
    displayName: Affectation
  justificatif:
    displayName: Justificatif
  sujet:
    displayName: Sujet
  niveau:
    displayName: Niveau
  lien:
    displayName: Lien
views:
  - type: table
    name: Projets
    filters:
      and:
        - type == "projet"
    groupBy:
      property: categorie
      direction: ASC
    order:
      - formula.note
      - categorie
      - statut
      - responsable
      - priorite
      - echeance
      - participants
    columnSize:
      formula.note: 110
      note.categorie: 112
      note.statut: 90
      note.responsable: 135
      note.priorite: 86
      note.echeance: 111
      note.participants: 287
  - type: table
    name: Compta
    filters:
      or:
        - type == "depense"
        - type == "entree"
    groupBy:
      property: formula.flux
      direction: ASC
    order:
      - formula.note
      - formula.flux
      - date
      - projet
      - montant
      - formula.montant_signe
      - formula.tiers
      - statut
      - categorie
      - justificatif
    sort:
      - property: date
        direction: DESC
      - property: formula.note
        direction: ASC
    summaries:
      formula.montant_signe: Sum
    columnSize:
      formula.note: 110
      formula.flux: 90
      note.date: 90
      note.projet: 120
      note.montant: 110
      formula.montant_signe: 110
      formula.tiers: 140
      note.statut: 110
  - type: table
    name: Dépenses
    filters:
      and:
        - type == "depense"
    groupBy:
      property: projet
      direction: ASC
    order:
      - formula.note
      - date
      - projet
      - montant
      - payeur
      - statut
      - categorie
      - justificatif
    summaries:
      montant: Sum
  - type: table
    name: Entrées
    filters:
      and:
        - type == "entree"
    groupBy:
      property: projet
      direction: ASC
    order:
      - formula.note
      - date
      - projet
      - montant
      - source
      - recu_par
      - moyen
      - affectation
      - statut
      - categorie
      - justificatif
    summaries:
      montant: Sum
  - type: table
    name: Ressources
    filters:
      and:
        - type == "ressource"
    groupBy:
      property: categorie
      direction: ASC
    order:
      - formula.note
      - categorie
      - sujet
      - niveau
      - lien
      - statut
      - projet
